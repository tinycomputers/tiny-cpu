{
  "name": "tiny-cpu-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Remotion project for the TinyCPU product demo video",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "data": "tsx scripts/gen-data.ts",
    "audio": "bash scripts/make-audio.sh",
    "render": "remotion render src/index.ts TinyCpuDemo out/tinycpu-demo.mp4 --codec h264 --crf 16",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/paths": "^4.0.541",
    "@remotion/shapes": "^4.0.541",
    "@remotion/tailwind-v4": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
