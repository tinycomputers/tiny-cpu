---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** JSON-LD for this page (schema.org). The home page describes the project as a SoftwareSourceCode. */
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = "TinyCPU is a real RV32I RISC-V CPU in SystemVerilog with a single-cycle core and a 5-stage pipeline, compiled to WebAssembly and running live in your browser.",
  structuredData,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Theme init runs before paint: saved choice, else OS preference, else dark. -->
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("cpu-theme");
        } catch (e) {}
        var preferLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.setAttribute("data-theme", saved || (preferLight ? "light" : "dark"));
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d1117" />
    <meta name="author" content="tinycomputers" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph and Twitter cards: the social preview when the link is shared. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TinyCPU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TinyCPU: a RISC-V CPU running in your browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
